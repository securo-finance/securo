FROM node:22-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=docker.io/oven/bun:1.4.4-slim /usr/local/bin/bun /usr/local/bin/bun
COPY package.json bun.lock bunfig.toml ./
# The stamp lets scripts/dev-start.sh tell when node_modules is out of date.
RUN bun install --frozen-lockfile && sha256sum bun.lock | cut -d ' ' -f 1 > node_modules/.bun-lock.sha256

COPY . .

EXPOSE 5173

CMD ["sh", "scripts/dev-start.sh"]
