FROM node:22-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
	&& rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json .npmrc ./
RUN npm install --global npm@11.10.0 --ignore-scripts \
	&& npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev"]
