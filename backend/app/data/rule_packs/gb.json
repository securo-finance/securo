        "name": "HMRC / Council Tax",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "contains",
            "value": "COUNCIL TAX"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "HMRC"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "taxes"
          }
        ],
        "priority": 10
      },
      {
        "key": "nhs-bupa",
        "name": "NHS / Bupa",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
