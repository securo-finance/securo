          }
        ],
        "priority": 10
      },
      {
        "key": "salary-wages",
        "name": "Salary / Wages",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "SALARY|WAGES|PAYROLL"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "salary"
          }
        ],
        "priority": 10
      },
      {
        "key": "charity-donation",
        "name": "Charity / Donation",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "contains",
            "value": "CHARITY"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "DONATION"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "JUST GIVING"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "donations"
          }
        ],
        "priority": 10
      },
      {
        "key": "rent-mortgage",
        "name": "Rent / Mortgage",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "contains",
            "value": "RENT"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "MORTGAGE"
          },
          {
            "field": "description",
            "op": "contains",
            "value": "OPENRENT"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "housing"
          }
        ],
        "priority": 10
      }
    ]
  }
}
