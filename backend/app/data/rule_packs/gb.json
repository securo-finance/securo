{
  "id": "securo/rules-gb",
  "name": {
    "en": "United Kingdom",
    "pt-BR": "Reino Unido"
  },
  "description": {
    "en": "Common merchants and transfer patterns, mapped to the default categories.",
    "pt-BR": "Estabelecimentos e padrões de transferência comuns, mapeados para as categorias padrão."
  },
  "version": "1.0.0",
  "repository": "https://github.com/securo-finance/securo",
  "license": "AGPL-3.0-only",
  "min_securo_version": "0.19.0",
  "contributes": {
    "rules": [
      {
        "key": "tesco-sainsbury-s-asda",
        "name": "Tesco / Sainsbury's / Asda",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "starts_with",
            "value": "TESCO"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "SAINSBURY"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "ASDA"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "groceries"
          }
        ],
        "priority": 10
      },
      {
        "key": "deliveroo-just-eat",
        "name": "Deliveroo / Just Eat",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "starts_with",
            "value": "DELIVEROO"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "JUST EAT"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "food"
          }
        ],
        "priority": 10
      },
      {
        "key": "tfl-trainline",
        "name": "TfL / Trainline",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
