          {
            "field": "description",
            "op": "starts_with",
            "value": "TRAINLINE"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "transport"
          }
        ],
        "priority": 10
      },
      {
        "key": "greggs-costa-pret",
        "name": "Greggs / Costa / Pret",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "starts_with",
            "value": "GREGGS"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "COSTA"
          },
          {
            "field": "description",
