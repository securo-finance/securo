        "actions": [
          {
            "op": "set_category",
            "value": "groceries"
          }
        ],
        "priority": 10
      },
      {
        "key": "aldi-lidl-morrisons-waitrose",
        "name": "Aldi / Lidl / Morrisons / Waitrose",
        "conditions_op": "or",
        "conditions": [
          {
            "field": "description",
            "op": "starts_with",
            "value": "ALDI"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "LIDL"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "MORRISONS"
          },
          {
            "field": "description",
            "op": "starts_with",
            "value": "WAITROSE"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "groceries"
          }
        ],
        "priority": 10
