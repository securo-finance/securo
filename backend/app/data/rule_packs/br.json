        "name": "Pix Recebido",
        "conditions_op": "and",
        "conditions": [
          {
            "field": "description",
            "op": "regex",
            "value": "PIX.*RECEBIDO"
          }
        ],
        "actions": [
          {
            "op": "set_category",
            "value": "transfers"
          }
        ],
        "priority": 50
      },
