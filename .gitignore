# Runtime artifacts written by the agents feature (uploaded KB files,
# downloaded ONNX embedding models, transaction attachments). User data
# — never commit.
backend/data/

# Default location of STORAGE_LOCAL_PATH ("./data/attachments"), resolved
# against the working directory. Running the plugin or export scripts from
# the repository root writes attachments here. Anchored to the root on
# purpose: a bare "data/" would also match backend/app/data/ (rule packs
# and default categories), which is versioned.
/data/

# Python bytecode. A .pyc from .github/ci/ was committed once.
__pycache__/
*.pyc
