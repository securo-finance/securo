# Optional. Left empty, Securo generates a unique key on first start and keeps
# it in the database. To manage it yourself, set a unique value:
#   openssl rand -hex 32
SECRET_KEY=
# Refuse to start when SECRET_KEY is missing or a public default, instead of
# generating one in the database (default false).
# REQUIRE_SECRET_KEY=true

# Database password (optional, docker-compose.prod.yml). Unset keeps the
# default `postgres`. Postgres only reads it when the data volume is first
# created, so on an existing install change it in the database first:
#   docker compose -f docker-compose.prod.yml exec db \
#     psql -U postgres -c "ALTER USER postgres PASSWORD 'new-password'"
# then set it here and run `docker compose -f docker-compose.prod.yml up -d`.
# A plain restart does not load the new value. It goes into a URL, so stick
# to URL-safe characters:
#   openssl rand -hex 24
# POSTGRES_PASSWORD=

# PostgreSQL JIT compilation. The bundled database runs with it off: it costs
# more than it saves on the short, indexed queries Securo runs (a transaction
# list went from 1222 ms to 229 ms on the hosted instance). Set to `on` to get
# the PostgreSQL default back:
# DB_JIT=on

# Connections the API keeps open to the database, and how many extra ones a
# burst may open before a request waits for a free one. Defaults are 5 and 10.
# With many people on one instance, raise both together with the database's
# max_connections (PostgreSQL's default allows 100 in total, and every worker
# and every Celery process takes its own connections). A request that still
# finds no free connection waits, and then gets a 503 saying the instance is
# busy instead of an error. DB_POOL_SIZE is at least 1; DB_MAX_OVERFLOW may be
# 0 so that the pool never grows past DB_POOL_SIZE.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20

# How PostgreSQL plans the queries the API sends. On by default: each
# statement is planned with the values of the call that runs it, which keeps
# reports on a large history fast. When a connection pooler (PgBouncer in
# transaction mode) refuses the parameter, the API connects again without it
# and logs a warning. Set it to false to stop sending it at all; the server's
# own plan_cache_mode stays then. Needs PostgreSQL 12 or newer.
# DB_FORCE_CUSTOM_PLANS=false

# Attachment storage: local (default) or s3. Create a private bucket first.
# S3 also stores invoice attachments and logos; AI knowledge files stay local.
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=securo-attachments
# STORAGE_S3_REGION=garage
# STORAGE_S3_ENDPOINT_URL=https://s3.example.com
# STORAGE_S3_ADDRESSING_STYLE=path
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_SESSION_TOKEN=
# For AWS S3, omit the endpoint and use addressing style auto. On bare metal
# or Kubernetes, omit both keys to use the SDK credential chain (e.g. IAM roles).

# Attachment types accepted on upload, comma separated. The default accepts
# jpg, jpeg, png, webp, gif, heic, pdf and xml; anything that isn't an image or
# a PDF, XML included, is handed over as a download. The backend reads it from
# its own environment, and in Compose this file does not reach it: add the key,
# with no value, to the shared `x-backend-env` block of docker-compose.yml and
# docker-compose.prod.yml (`backend/.env` also works in development). A key set
# on the backend service's own `environment:` does not survive: YAML merges
# shallowly, so that block replaces the one it inherits, DATABASE_URL included.
# Unset, the default above applies.
# STORAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,heic,pdf,xml

# Public sign-up (optional). Applies until an administrator saves the toggle
# on the admin settings page, whose saved value then wins.
# REGISTRATION_ENABLED=false

# Let Postgres enforce the workspace boundary too (ADR 0043, not complete yet).
# DATABASE_URL must name a restricted role, set up by the owner of the tables
# with: python -m app.cli apply-row-security <role>
# It also needs SECRET_KEY set. An install that ran without one sets it to the
# key already stored in the database, so saved credentials keep opening.
# ROW_SECURITY_ENABLED=false

# Operator of a hosted instance only (ADR 0045): makes the instance-wide admin
# settings read-only. Off by default; leave it alone on a self-hosted install.
# MANAGED_INSTANCE=true
# With MANAGED_INSTANCE on, each account is held to the limits the operator
# writes for it (workspaces, bank connections, members; ADR 0049). Only the
# operator writes them, through /api/operator/quotas with this token as a
# bearer. Unset, that route answers 404. A self-hosted instance leaves it empty.
# OPERATOR_TOKEN=

# Bank sync: Pluggy (https://pluggy.ai)
## 1. Create an account at https://dashboard.pluggy.ai
## 2. Copy your Client ID and Client Secret
## 3. Add http://localhost:${FRONTEND_PORT}/oauth/callback as an allowed redirect URI
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Bank sync: Enable Banking (https://enablebanking.com) for European banks
## 1. Sign up at https://enablebanking.com and create a Production application
## 2. Add http://localhost:${FRONTEND_PORT}/oauth/callback as an allowed redirect URL
## 3. Save the downloaded PEM file to ./secrets/enable_banking_private.pem
## 4. Copy your Application ID below
ENABLE_BANKING_APP_ID=
# Override only if you put the PEM somewhere other than the default below
# ENABLE_BANKING_PRIVATE_KEY_FILE=/app/secrets/enable_banking_private.pem
# Defaults to ${FRONTEND_URL}/oauth/callback. Set it only when the URL you
# registered in your EB application differs from where the app is served.
# ENABLE_BANKING_OAUTH_REDIRECT_URI=https://securo.example.com/oauth/callback

# Exchange rates (optional): Open Exchange Rates (https://openexchangerates.org/)
## The rates are the instance's: one app id serves every workspace, and a day
## already fetched is reused. Use a separate app id per environment (local,
## staging, hosted) so one environment's traffic never spends another's quota.
## Plan: the free plan allows 1,000 requests a month. Historical rows are
## sampled once per month of data (not once per day), so a small instance fits;
## a public instance with open sign-up needs at least the Developer plan
## (US$ 12/month, 10,000 requests). Without an app id, cross-currency amounts
## stay unconverted and read as 1:1.
OPENEXCHANGERATES_APP_ID=

# OIDC login (optional): Authentik, Pocket ID, or any standard OIDC provider
## Redirect/callback URL to register in the provider:
##   http://localhost:${FRONTEND_PORT:-3000}/api/auth/oidc/callback
# OIDC_ENABLED=true
# OIDC_PROVIDER_NAME="My SSO"
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=securo
# OIDC_CLIENT_SECRET=your-client-secret
# Quoted on purpose: values with spaces must be quoted for deploy scripts
# that source this file with a shell. Compose and the backend strip the quotes.
# OIDC_SCOPES="openid email profile"
# OIDC_AUTO_REGISTER=true
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Optional: require OIDC-only login; requires OIDC_ENABLED, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL
# Disables local login, registration, password reset/change, and new passkey ceremonies
# LOCAL_AUTH_ENABLED=false
# Link an OIDC login to an existing Securo account with the same email:
#   disabled (default) never links, verified_email links only when the provider
#   sends email_verified=true, email links on a matching email alone.
# OIDC_EXISTING_USER_LINK_MODE=disabled
# Optional: sync Securo admin/workspace roles from OIDC roles/groups
# OIDC_SYNC_ROLES=true
# OIDC_ROLES_CLAIM=groups
# OIDC_ADMIN_ROLES=securo-admins
# OIDC_WORKSPACE_ROLE_MAP={"securo-owners":"owner","securo-editors":"editor","securo-viewers":"viewer"}
# Optional: where the browser goes after signing out, so the provider's own
# session ends too (RP-initiated logout, issue #1623). Empty reads
# end_session_endpoint from the discovery document. Keycloak example:
# OIDC_LOGOUT_URL=https://id.example.com/realms/main/protocol/openid-connect/logout
# Securo adds only client_id to that URL and sends no post_logout_redirect_uri
# of its own, so the provider ends its session and shows its own page. To have
# it send people back, register the return address on the provider's client and
# put it in OIDC_LOGOUT_URL yourself:
# OIDC_LOGOUT_URL=https://id.example.com/realms/main/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2Fapp.example.com%2Flogin

# Password recovery by email (optional, off by default). With this on, the
# "Forgot password?" link on the sign-in page sends a recovery link through
# your own SMTP server or a hosted email API. With it off, nothing is sent and
# /api/auth/forgot-password answers 503, so nobody is told a mail went out when
# none did. The link opens FRONTEND_URL, so set that to the address people
# reach the app on. Administrators can rewrite the message under
# Admin Settings -> Email in the app.
# EMAIL_ENABLED=true
# How the message goes out: smtp (below) or resend (the hosted API).
# EMAIL_PROVIDER=smtp
# With EMAIL_PROVIDER=resend, only these are needed:
# RESEND_API_KEY=re_your_key
# RESEND_API_URL=https://api.resend.com
# EMAIL_FROM="Securo <no-reply@example.com>"
# With EMAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls (587), ssl (465) or none (local relay)
# SMTP_USERNAME=no-reply@example.com
# SMTP_PASSWORD=your-smtp-password
# The From address. Empty uses SMTP_USERNAME.
# EMAIL_FROM="Securo <no-reply@example.com>"
# How long a recovery link stays valid, in minutes.
# PASSWORD_RESET_TOKEN_MINUTES=60

# Brazilian Treasury bond lookup (Tesouro Direto). On by default; uncomment to
# disable (e.g. to avoid the dependency on the Brazilian government CSV endpoint).
# TESOURO_DIRETO_ENABLED=false

# Market indices for the Performance tab (Yahoo Finance, and the B3 Índice DI
# from the Central Bank of Brazil and Ipeadata). On by default and only contacted
# when someone compares against an index; uncomment to disable. Portfolio
# returns keep working without them.
# PERFORMANCE_BENCHMARKS_ENABLED=false

# Passkeys (optional). Nothing to set for the common cases.
## Passkeys follow the address you open the app on, so they work out of the box on
## http://localhost:3000 and on any HTTPS domain behind a reverse proxy.
##
## Two limits come from the WebAuthn standard itself, not from Securo:
##   - an IP address (http://192.168.1.10:3000) can never be used for passkeys
##   - plain HTTP can never be used, except on localhost
## Reach the app on a domain over HTTPS, or on http://localhost, to use passkeys.
##
## Set FRONTEND_URL when the app is served from a domain; it is also used for
## CORS and OAuth callbacks.
# FRONTEND_URL=https://securo.example.com
##
## Optional: pin passkeys to a single domain. Leave unset to follow the browser.
## Set it to the parent domain if you reach the app on several subdomains.
# WEBAUTHN_RP_ID=securo.example.com
## Optional: the name shown in the browser's passkey prompt.
# WEBAUTHN_RP_NAME=Securo

# Serve the frontend from the API (optional). Off by default: the stock
## setup serves it from the frontend container. Point this at a built
## frontend (the `dist` folder from `npm run build`) to have the backend serve
## the app itself on its own port. Health checks should use /api/health.
# FRONTEND_DIST_PATH=/app/frontend/dist

# Timezone (optional). Calendar dates follow the timezone saved in Admin
## Settings; without one, this variable, then the host timezone, then UTC.
# TZ=America/Sao_Paulo

# Host ports (optional). Change these to avoid conflicts with other services
## Default values are set in docker-compose.yml and docker-compose.prod.yml.
## Example:
# FRONTEND_PORT=3132
# BACKEND_PORT=8182
## FRONTEND_PORT also takes an address, e.g. FRONTEND_PORT=127.0.0.1:3000 when
## a reverse proxy on the same host is the only way in.
## In docker-compose.prod.yml the backend port listens on loopback only, since
## the frontend proxies /api to it. BACKEND_BIND_ADDRESS sets the address
## separately: use 0.0.0.0 only if something off the host must call the backend
## directly. Keep BACKEND_PORT a plain port number there: an address such as
## BACKEND_PORT=127.0.0.1:8000 no longer starts, so move it to
## BACKEND_BIND_ADDRESS.
# BACKEND_BIND_ADDRESS=0.0.0.0

# Reverse proxy labels (optional, docker-compose.prod.yml only): static
# Traefik routing labels on the frontend service, for setups (e.g. some
# Coolify versions) where the proxy's own domain UI doesn't turn into
# working Traefik labels on this compose file. Off by default.
# TRAEFIK_ENABLE=true
# FRONTEND_DOMAIN=securo.example.com
## Set to a network name shared by this stack and your Traefik/proxy
## container. Find it with `docker network ls` or `docker inspect
## <traefik-container> --format '{{json .NetworkSettings.Networks}}'`.
## Leave unset to let Traefik auto-detect the shared network; it works as
## long as `frontend` is on exactly one network (the default). REQUIRED if
## you've attached `frontend` to more than one network yourself.
# TRAEFIK_NETWORK=
## Only if your ACME resolver isn't named "letsencrypt".
# TRAEFIK_CERTRESOLVER=letsencrypt
## Must be unique per deployment if multiple Securo instances share the
## same Traefik/Coolify proxy; otherwise their router/service names collide.
# TRAEFIK_RESOURCE_NAME=securo-frontend

# Backups (optional)
## Server-created and scheduled backups always write inside containers to the fixed
## path /app/data/backups. Docker Compose exposes that fixed internal directory on
## the host path below; change only this host path to choose where ZIPs live.
## On SELinux hosts (Fedora, RHEL) the folder is relabelled for container use,
## so point it at a folder kept for backups, never a home or system folder.
# BACKUP_HOST_PATH=./data/backups

# Plugins (optional). Lets workspace members install data plugins (categories
# and rules) from the plugin catalog, with a preview before anything
# changes. No extra container. The catalog is fetched only when someone opens
# it; while this is off nothing is fetched and no plugin can be installed.
# PLUGINS_ENABLED=true
# Point this at a mirror or your own index; manifests, READMEs and plugin icons are
# read from the same host (an icon when a browser asks Securo for it).
# PLUGINS_INDEX_URL=https://plugins.usesecuro.com/v1/index.json
# Plugins with code run in their own containers, never in the backend:
# plugins-runner (no core secrets, no database, no internet) and
# plugins-egress (lets each plugin reach only the hosts it declares). They
# start only with the `plugins` profile, so add it to COMPOSE_PROFILES
# (e.g. COMPOSE_PROFILES=plugins) and point the backend at the runner.
# PLUGINS_RUNNER_URL=http://plugins-runner:8090
# Both are required with the `plugins` profile, in development too: set each
# to a long random value (`openssl rand -hex 32`, 32 characters or more). The
# runner and plugins-egress refuse to start without them.
# PLUGINS_RUNNER_TOKEN=
# PLUGINS_EGRESS_SECRET=

# AI Agents (optional). To enable, set BOTH:
#   1) the feature flag
#   2) COMPOSE_PROFILES so `docker compose up` starts the mcp-server container
#      (Docker Compose only. On a bare-metal/LXC install set just the flag,
#      run `uvicorn mcp_server.main:app --port 8765` next to the API, and set
#      AGENTS_BUILTIN_MCP_URL=http://127.0.0.1:8765/mcp)
# AGENTS_ENABLED=true
# COMPOSE_PROFILES=agents
# Signing key for the MCP server's JWTs (optional). Leave it empty to derive
# it from SECRET_KEY, which is always unique (generated if you don't set one).
# A known public value is ignored and the derived key used instead, because
# anyone holding it could mint a token for any user. Set it only to rotate
# this key separately from SECRET_KEY (`openssl rand -hex 32`).
# AGENTS_MCP_JWT_SECRET=
# Public URL external agents use to reach the built-in MCP server, shown in the
# UI token panel. Leave unset to derive it from the browser (host:8765). Set it
# when the MCP server is exposed behind an ingress/reverse proxy on a custom
# host, subpath, or standard 80/443 port instead of :8765.
# AGENTS_EXTERNAL_MCP_URL=https://securo.example.com/mcp
# Per-IP limit on assistant chat messages, in requests per minute. Every
# message spends provider tokens, so lower it (for example 5) when the
# instance is a public demo. A turn that runs several tools is still one
# request. 0 turns the limit off.
# The key is the client IP, resolved through TRUSTED_PROXY_HOPS. Behind the
# bundled proxy set TRUSTED_PROXY_HOPS=1; with it at 0 every visitor is seen
# as the proxy and they all share one bucket. With Traefik ahead of that
# proxy there are two hops, so use 2. The header is only read past a proxy
# in TRUSTED_PROXY_NETWORKS, so a caller on an open port cannot forge it as
# long as that caller is outside those networks. The default covers every
# private range: when untrusted LAN or VPN clients share them, or Docker shows
# direct callers as the bridge gateway, set the networks to the proxies' own
# addresses only (ADR 0024).
# AGENTS_CHAT_RATE_LIMIT_PER_MINUTE=30
